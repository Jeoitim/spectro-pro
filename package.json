{
  "name": "spectro-pro",
  "version": "0.1.0",
  "description": "Modern real-time acoustic visualizer for the web.",
  "scripts": {
    "test": "npm run test:analysis",
    "test:analysis": "tsc -p tsconfig.tests.json && node .test-dist/tests/synthetic-analysis.js",
    "build": "webpack --mode=production && node scripts/prepare-sites-build.cjs",
    "start": "webpack serve --mode=development",
    "prettier": "prettier --write 'src/**/*.{ts,tsx}'",
    "type-check": "tsc -p tsconfig.json && tsc -p src/workers/tsconfig.json"
  },
  "author": "Spectro Pro contributors; based on Spectro by Caleb Joseph",
  "license": "MIT",
  "homepage": "https://github.com/Jeoitim/spectro-pro",
  "bugs": "https://github.com/Jeoitim/spectro-pro/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeoitim/spectro-pro.git"
  },
  "dependencies": {
    "@material-ui/core": "^4.11.3",
    "@material-ui/icons": "^4.11.2",
    "@types/lodash.debounce": "^4.0.6",
    "@types/react-dom": "^17.0.2",
    "jsfft": "0.0.4",
    "lodash.debounce": "^4.0.8",
    "ml-matrix": "^5.3.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.13.8",
    "@babel/preset-env": "^7.13.10",
    "@babel/preset-react": "^7.12.13",
    "@babel/preset-typescript": "^7.13.0",
    "@typescript-eslint/eslint-plugin": "^4.17.0",
    "babel-loader": "^8.2.2",
    "eslint": "^7.22.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-restricted-globals": "^0.2.0",
    "prettier": "^2.2.1",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-glsl-minify": "^1.4.2",
    "worker-loader": "^3.0.8"
  }
}
